# Sanity project ID (sanity.io/manage). Public, safe in the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Sanity dataset name. Keep "production".
NEXT_PUBLIC_SANITY_DATASET=production
# Sanity token with Editor access. Server only. Used by bookings and the seed script.
SANITY_API_WRITE_TOKEN=
# Shared secret the Sanity "revalidate" webhook sends to /api/revalidate.
SANITY_REVALIDATE_SECRET=
# Shared secret the Sanity "booking status" webhook sends to /api/booking-status.
SANITY_BOOKING_WEBHOOK_SECRET=
# Resend API key (resend.com). Server only.
RESEND_API_KEY=
# Sender address. Use onboarding@resend.dev until the domain is verified in Resend.
BOOKING_FROM_EMAIL=onboarding@resend.dev
# URL of the hosted Studio (e.g. https://studio-1-barbershop.sanity.studio), used for "Open in Studio" links in emails.
STUDIO_URL=
# Public site URL with no trailing slash, e.g. https://www.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true only when Helcim online card payments are built and ready.
PAYMENTS_HELCIM_ENABLED=false
# Helcim API token. Only read when PAYMENTS_HELCIM_ENABLED=true.
HELCIM_API_TOKEN=
# Optional: Upstash Redis REST URL for rate limiting across serverless instances.
UPSTASH_REDIS_REST_URL=
# Optional: Upstash Redis REST token.
UPSTASH_REDIS_REST_TOKEN=
